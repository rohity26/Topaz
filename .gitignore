# =====================================================================
# Added 2026-10-15 — keep datasets and vendored sources out of GitHub.
# Repo is ~14 GB on disk; almost all of it is data + srsRAN source.
# =====================================================================

# ---- Collected datasets (8.7 GB) -----------------------------------
# Ignore the contents, not the directory itself, so the context doc
# below can be re-included (git cannot re-include a file whose parent
# directory is excluded).
experimental_phase0/data_fs_plane/**
!experimental_phase0/data_fs_plane/
!experimental_phase0/data_fs_plane/DATASET_CONTEXT.md

# ---- Modeling pipeline outputs (3.0 GB) ----------------------------
data-modeling/clear_pipeline/**
!data-modeling/clear_pipeline/
!data-modeling/clear_pipeline/**/
!data-modeling/clear_pipeline/**/*.py
!data-modeling/clear_pipeline/**/*.md
!data-modeling/clear_pipeline/**/*.yaml
!data-modeling/clear_pipeline/**/*.yml
!data-modeling/clear_pipeline/**/*.json
!data-modeling/clear_pipeline/**/*.txt

